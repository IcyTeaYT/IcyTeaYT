# ─── Phase 1 (demo mode) ──────────────────────────────────────────────────────
# demo = read committees/users from src/data/mock/*.json in the browser
# live = read everything from the Pages Functions in functions/api (Phase 2)
VITE_DATA_MODE=demo

# ─── Phase 2 (live mode) ──────────────────────────────────────────────────────
# Google OAuth client ID. Public by design — it ships in the frontend bundle.
# Leave blank in Phase 1: the login page then shows "Not configured yet".
VITE_GOOGLE_CLIENT_ID=

# School Google Workspace domain, e.g. tashkentis.uz. Shown in the login hint.
# The server-side check in functions/api/session.ts uses SCHOOL_DOMAIN below —
# this copy is only for the message the delegate reads.
VITE_SCHOOL_DOMAIN=

# ─── Server-side only — set these in the Cloudflare Pages dashboard ───────────
# NEVER prefix these with VITE_. Anything VITE_-prefixed is public.
# For local `wrangler pages dev`, put them in .dev.vars (git-ignored).
#
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# SCHOOL_DOMAIN=tashkentis.uz
# SHEET_ID=1AbCdEf...                       # the Google Sheet's ID from its URL
# GOOGLE_SA_EMAIL=tismun-sheets@project.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# SESSION_SECRET=<64+ random chars, e.g. `openssl rand -hex 32`>
